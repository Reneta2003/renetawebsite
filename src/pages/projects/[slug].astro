---
/**
 * One page per project, generated from src/content/projects/<slug>.json.
 * Gives every project a descriptive, shareable URL with its own structured data.
 */
import { Image, getImage } from 'astro:assets';
import { getEntries } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getProfile, getProjects, projectKind, projectPeriod, projectUrl, type Project } from '../../lib/content';
import { paragraphs } from '../../lib/rich-text';
import { projectGraph } from '../../lib/structured-data';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, previous: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props {
  project: Project;
  previous?: Project;
  next?: Project;
}
const { project, previous, next } = Astro.props;
const { data } = project;
const profile = await getProfile();
const categories = await getEntries(data.categories);
const kind = projectKind(project);
const period = projectPeriod(project);
const site = Astro.site!;

const ogImage = data.image ? await getImage({ src: data.image.src, format: 'jpg', width: 744 }) : undefined;
const jsonLd = projectGraph(site, profile, project, categories, ogImage && new URL(ogImage.src, site).href);
const title = `${data.title} — ${kind.split(' · ')[0]} by ${profile.name}`;
const description = `${data.summary} ${data.context}${period ? `, ${period}` : ''}. Skills: ${data.skills.slice(0, 6).join(', ')}.`;
---

<Base
  title={title}
  description={description.slice(0, 170)}
  path={projectUrl(project)}
  ogType="article"
  ogImage={ogImage?.src}
  ogImageAlt={data.image?.alt}
  jsonLd={jsonLd}
>
  <header class="top">
    <div class="wrap">
      <nav class="top__nav" aria-label="Primary">
        <a class="top__wordmark" href="/">reneta.nl</a>
        <a href="/#projects">All projects</a>
        <a href={`mailto:${profile.email}`}>Email</a>
      </nav>
      <nav aria-label="Breadcrumb">
        <ol class="crumbs">
          <li><a href="/">{profile.name}</a></li>
          <li><a href="/#projects">Projects</a></li>
          <li aria-current="page">{data.title}</li>
        </ol>
      </nav>
      <h1 class="top__title">{data.title}</h1>
      <p class="top__summary">{data.summary}</p>
      <p class="top__meta">
        <span class="kind">{kind}</span>
        {period && <time datetime={data.period?.start}>{period}</time>}
        {data.period?.approximate && <span class="visually-hidden"> (approximate dates)</span>}
      </p>
    </div>
  </header>

  <main id="main" tabindex="-1" class="wrap body">
    <article class="body__text" aria-labelledby="about-title">
      <h2 id="about-title" class="visually-hidden">About this project</h2>
      {paragraphs(data.description).map((p) => <p>{p}</p>)}
      {
        data.image && (
          <figure class="body__figure">
            <Image src={data.image.src} alt={data.image.alt} widths={[372, 744]} sizes="(max-width: 767px) 100vw, 372px" loading="eager" />
          </figure>
        )
      }
    </article>

    <aside class="facts" aria-label="Project facts">
      <dl>
        <div>
          <dt>Areas</dt>
          <dd>
            <ul class="inline-list">
              {
                categories.map((c) => (
                  <li>
                    <a href={`/?area=${c.id}#projects`}>{c.data.label}</a>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
        <div>
          <dt>Skills and technologies</dt>
          <dd>
            <ul class="inline-list">{data.skills.map((s) => <li>{s}</li>)}</ul>
          </dd>
        </div>
        <div>
          <dt>Setting</dt>
          <dd>{[data.context, data.collaboration === 'team' ? 'Team project' : 'Individual work', data.client && `For ${data.client}`, data.institution].filter(Boolean).join(' · ')}</dd>
        </div>
        {
          data.awards.length > 0 && (
            <div>
              <dt>Recognition</dt>
              <dd class="facts__award">{data.awards.join(' · ')}</dd>
            </div>
          )
        }
        {
          data.links.length > 0 && (
            <div>
              <dt>Links</dt>
              <dd>
                <ul class="inline-list">
                  {data.links.map((l) => (
                    <li>
                      <a href={l.url} rel="noopener">
                        {l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>
    </aside>
  </main>

  <nav class="wrap pager" aria-label="More projects">
    {
      previous && (
        <a class="pager__link" href={projectUrl(previous)} rel="prev">
          <span class="pager__label">Previous</span>
          {previous.data.title}
        </a>
      )
    }
    {
      next && (
        <a class="pager__link pager__link--next" href={projectUrl(next)} rel="next">
          <span class="pager__label">Next</span>
          {next.data.title}
        </a>
      )
    }
  </nav>

  <SiteFooter profile={profile} />
</Base>

<style>
  .top {
    background: var(--powder);
    padding: 28px 0 56px;
  }

  .top__nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-weight: 500;
  }

  .top__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .top__nav a:hover {
    text-decoration: underline;
  }

  .top__wordmark {
    margin-right: auto;
    font-weight: 700;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 56px;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 8px;
    color: var(--navy-soft);
  }

  .top__title {
    margin-top: 16px;
    max-width: 1000px;
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .top__summary {
    margin-top: 20px;
    max-width: 680px;
    font-size: clamp(1.1875rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.35;
  }

  .top__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: 24px;
    font-weight: 600;
  }

  .kind::first-letter {
    text-transform: uppercase;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 64px;
    padding-top: 72px;
  }

  .body__text {
    max-width: 720px;
    font-size: 1.1875rem;
    line-height: 1.65;
  }

  .body__text p + p {
    margin-top: 16px;
  }

  .body__figure {
    margin-top: 40px;
    max-width: 372px;
  }

  .facts dl {
    display: grid;
    gap: 24px;
  }

  .facts dt {
    font-size: 0.875rem;
    font-weight: 700;
  }

  .facts dd {
    margin: 6px 0 0;
    line-height: 1.5;
  }

  .facts__award {
    display: inline-block;
    background: var(--lime);
    padding: 0 0.2em;
    font-weight: 600;
  }

  .inline-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    padding: 0;
    list-style: none;
  }

  .inline-list a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-weight: 600;
  }

  .pager {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 96px;
    padding-top: 24px;
  }

  /* Rule aligned with the content column, not the padded wrapper. */
  .pager::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: var(--gutter);
    height: 3px;
    background: var(--navy);
  }

  .pager__link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
  }

  .pager__link:hover {
    text-decoration: underline;
  }

  .pager__link--next {
    margin-left: auto;
    text-align: right;
  }

  .pager__label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--navy-soft);
  }

  @media (max-width: 899px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      padding-top: 40px;
    }
  }

  @media (max-width: 767px) {
    .top {
      padding: 12px 0 36px;
    }

    .top__nav {
      gap: 16px;
      font-size: 0.9375rem;
    }

    .crumbs {
      margin-top: 28px;
      font-size: 0.8125rem;
    }

    .body__text {
      font-size: 1.0625rem;
    }

    .pager {
      margin-top: 56px;
    }

    .pager__link {
      font-size: 1rem;
    }
  }
</style>
