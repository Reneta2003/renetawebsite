---
/**
 * Document shell: metadata, canonical URL, Open Graph, structured data and fonts.
 * Every page passes its own title/description/path; absolute URLs come from `site`
 * in astro.config.mjs.
 */
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path of this page, e.g. "/" or "/projects/pentago/". */
  path: string;
  /** Absolute or root-relative image for social previews. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'profile' | 'article';
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = '/og.jpg',
  ogImageAlt = 'Reneta Trifonova — software engineer',
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const site = Astro.site!;
const canonical = new URL(path, site).href;
const ogImageUrl = new URL(ogImage, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content="Reneta Trifonova" />
    <meta name="theme-color" content="#a8dadc" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Plain-text profile for AI agents" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Reneta Trifonova" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <Font cssVariable="--font-bricolage" preload />
    <slot name="head" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
