---
/**
 * Art-directed hero photo: a wide crop for tablet/desktop, a tighter portrait for
 * phones (the design uses a different photo on each). AVIF and WebP with a JPEG
 * fallback; loaded eagerly with high priority because it is the LCP element.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  desktop: ImageMetadata;
  mobile: ImageMetadata;
  alt: string;
  /** Media query that selects the desktop crop. */
  desktopMedia: string;
  class?: string;
}

const { desktop, mobile, alt, desktopMedia, class: className } = Astro.props;

const DESKTOP_WIDTHS = [640, 960, 1280, 1600];
const MOBILE_WIDTHS = [400, 780, 1170];

async function srcset(src: ImageMetadata, widths: number[], format: 'avif' | 'webp' | 'jpg') {
  const images = await Promise.all(
    widths
      .filter((w) => w <= src.width)
      .map((width) => getImage({ src, width, format, quality: format === 'avif' ? 55 : 72 })),
  );
  return images.map((img) => `${img.src} ${img.attributes.width}w`).join(', ');
}

const formats = ['avif', 'webp'] as const;
const desktopSources = await Promise.all(formats.map(async (f) => ({ type: `image/${f}`, srcset: await srcset(desktop, DESKTOP_WIDTHS, f) })));
const mobileSources = await Promise.all(formats.map(async (f) => ({ type: `image/${f}`, srcset: await srcset(mobile, MOBILE_WIDTHS, f) })));
const fallbackSrcset = await srcset(mobile, MOBILE_WIDTHS, 'jpg');
const fallback = await getImage({ src: mobile, width: 780, format: 'jpg', quality: 72 });
const desktopFallback = await srcset(desktop, DESKTOP_WIDTHS, 'jpg');
---

<picture class={className}>
  {desktopSources.map((s) => <source media={desktopMedia} type={s.type} srcset={s.srcset} sizes="50vw" />)}
  <source media={desktopMedia} srcset={desktopFallback} sizes="50vw" />
  {mobileSources.map((s) => <source type={s.type} srcset={s.srcset} sizes="100vw" />)}
  <img
    src={fallback.src}
    srcset={fallbackSrcset}
    sizes="100vw"
    alt={alt}
    width={fallback.attributes.width}
    height={fallback.attributes.height}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
</picture>
