---
/** Renders content text, turning **keywords** into highlighted <strong> elements. */
import { richTextToHtml } from '../lib/rich-text';

interface Props {
  text: string;
  as?: 'p' | 'span' | 'li';
  class?: string;
}
const { text, as: Tag = 'p', class: className } = Astro.props;
---

<Tag class={className} set:html={richTextToHtml(text)} />
